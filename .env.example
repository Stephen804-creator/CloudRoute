# Local development only. Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_APP_ORIGIN=http://localhost:3000
CLOUDROUTE_API_INTERNAL_URL=http://127.0.0.1:4000

# Local values for docker-compose.yml. Use managed secret storage in production.
DATABASE_URL=postgresql://cloudroute_app:cloudroute_dev_password@127.0.0.1:5432/cloudroute
DATABASE_SSL=false
DB_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2

# Production requires NODE_ENV=production, a PostgreSQL DATABASE_URL,
# DATABASE_SSL=true, and an HTTPS PUBLIC_APP_ORIGIN with no path.
# Set HOST=0.0.0.0 in production containers.

# Set this only after CloudRoute is deployed with a dedicated AWS runtime role.
CLOUDROUTE_AWS_PRINCIPAL_ARN=

# CloudRoute does not accept long-lived AWS access keys.
# Google Cloud uses runtime Application Default Credentials and service-account impersonation.
# Do not add customer service-account private keys here.

# Optional Google OAuth login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional outbound email via Resend. Leave unset to retain queued messages without delivery.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=CloudRoute <notifications@example.com>
