{
  "name": "@cloudroute/connector-aws",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/inventory.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-rds": "^3.883.0",
    "@aws-sdk/client-lambda": "^3.883.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.883.0",
    "@aws-sdk/types": "^3.862.0",
    "@cloudroute/shared": "workspace:*",
    "@cloudroute/connector-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}