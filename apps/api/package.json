{
  "name": "@cloudroute/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/index.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@cloudroute/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@aws-sdk/client-sts": "^3.883.0",
    "@aws-sdk/client-ec2": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-rds": "^3.883.0",
    "@aws-sdk/client-lambda": "^3.883.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.883.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  }
}
