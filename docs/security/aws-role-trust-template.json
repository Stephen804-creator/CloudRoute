{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudRouteAssumeRoleWithExternalId",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<CLOUDROUTE_AWS_PRINCIPAL_ACCOUNT_ID>:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<EXTERNAL_ID_SHOWN_DURING_CLOUDROUTE_SETUP>"
        }
      }
    }
  ]
}
